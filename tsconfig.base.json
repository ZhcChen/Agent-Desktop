{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@agent-desktop/app-server-protocol": ["packages/app-server-protocol/src/index.ts"],
      "@agent-desktop/agent-host": ["packages/agent-host/src/index.ts"],
      "@agent-desktop/runtime": ["packages/runtime/src/index.ts"]
    }
  }
}
